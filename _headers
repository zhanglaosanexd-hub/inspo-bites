/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/script.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/data/content.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
